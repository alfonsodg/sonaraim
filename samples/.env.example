# Sonaraim Ecosystem Environment Template
# Copy to .env and populate values per environment (dev / qa / prod)

# Global
SONARAIM_ENV=dev
LOG_LEVEL=INFO

# Persistence & Object Storage
POSTGRES_USER=sonaraim
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=sonaraim
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
POSTGRES_VOLUME_PATH=/var/lib/sonaraim/postgres

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_VOLUME_PATH=/var/lib/sonaraim/redis

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_MEDIA=sonaraim-media-ephemeral
S3_BUCKET_VAULT=sonaraim-zk-vaults
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
MINIO_VOLUME_PATH=/var/lib/sonaraim/minio

# Core P2P & Identity Node (sonaraim-node)
NODE_IMAGE=ghcr.io/alfonsodg/sonaraim-node:latest
NODE_ID=node-primary-01
NODE_HTTP_HOST=0.0.0.0
NODE_HTTP_PORT=8040
NODE_P2P_PORT=8041
NODE_P2P_LISTEN_ADDR=/ip4/0.0.0.0/udp/8041/quic-v1
NODE_BOOTSTRAP_PEERS=
NODE_SIGNING_KEY_PATH=/etc/sonaraim/keys/node_ed25519.key
NODE_ENVELOPE_TTL_SECONDS=2592000
NODE_L2_ANCHOR_ENABLED=false
NODE_L2_RPC_URL=
NODE_DATA_VOLUME_PATH=/var/lib/sonaraim/node

# Enterprise B2B Gateway (sonaraim-b2b)
B2B_IMAGE=ghcr.io/alfonsodg/sonaraim-b2b:latest
B2B_HTTP_HOST=0.0.0.0
B2B_HTTP_PORT=8042
B2B_GRPC_PORT=8043
B2B_NODE_RPC_URL=http://sonaraim-node:8040
B2B_KMS_MASTER_KEY=CHANGE_ME_32_BYTE_HEX_MASTER_KEY
B2B_PROMO_RATE_LIMIT_RPS=50
B2B_INSTANT_CLIP_BASE_URL=https://go.sonaraim.com
B2B_WEBHOOK_TIMEOUT_MS=5000
B2B_STORAGE_PATH=/var/lib/sonaraim-b2b/state.jsonl
B2B_DATA_VOLUME_PATH=/var/lib/sonaraim/b2b

# Admin & B2B Console (sonaraim-admin)
ADMIN_IMAGE=ghcr.io/alfonsodg/sonaraim-admin:latest
ADMIN_HTTP_PORT=8044
VITE_B2B_API_BASE_URL=https://api.sonaraim.com
VITE_NODE_API_BASE_URL=https://node.sonaraim.com

# B2C Instant Web / App Clip Client (sonaraim-app)
APP_WEB_IMAGE=ghcr.io/alfonsodg/sonaraim-app-web:latest
APP_WEB_PORT=8045
PUBLIC_LIVEKIT_URL=wss://rtc.sonaraim.com
LIVEKIT_HTTP_PORT=8046
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET
