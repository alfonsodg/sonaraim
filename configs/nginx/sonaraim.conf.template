# Parameterized Nginx TLS reverse-proxy template for Sonaraim production deployments
# Render with envsubst before reloading system Nginx:
#   envsubst '${SONARAIM_PUBLIC_DOMAIN} ${NODE_HTTP_PORT} ${B2B_HTTP_PORT} ${ADMIN_HTTP_PORT} ${APP_WEB_PORT}' < sonaraim.conf.template > /etc/nginx/sites-available/sonaraim.conf

limit_req_zone $binary_remote_addr zone=sonaraim_api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=sonaraim_auth_limit:10m rate=10r/m;

server {
    listen 80;
    server_name ${SONARAIM_PUBLIC_DOMAIN} node.${SONARAIM_PUBLIC_DOMAIN} b2b.${SONARAIM_PUBLIC_DOMAIN} admin.${SONARAIM_PUBLIC_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${SONARAIM_PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" always;

    location /auth/ {
        limit_req zone=sonaraim_auth_limit burst=10 nodelay;
        proxy_pass http://127.0.0.1:${APP_WEB_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=sonaraim_api_limit burst=40 nodelay;
        proxy_pass http://127.0.0.1:${APP_WEB_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name node.${SONARAIM_PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        limit_req zone=sonaraim_api_limit burst=60 nodelay;
        proxy_pass http://127.0.0.1:${NODE_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name b2b.${SONARAIM_PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        limit_req zone=sonaraim_api_limit burst=60 nodelay;
        proxy_pass http://127.0.0.1:${B2B_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name admin.${SONARAIM_PUBLIC_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SONARAIM_PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        limit_req zone=sonaraim_api_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:${ADMIN_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
