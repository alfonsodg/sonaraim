{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonaraim.com/schemas/sonaraim-card.schema.json",
  "title": "Sonaraim Declarative Interactive Card Specification",
  "description": "Zero-HTML declarative UI schema for signed native interactive cards inside Sonaraim chats.",
  "type": "object",
  "required": ["schema_version", "card_id", "title", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "card_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "subtitle": {
      "type": "string",
      "maxLength": 280
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "TEXT_BLOCK",
              "KEY_VALUE_LIST",
              "LIVE_MAP",
              "ITEM_SELECTOR",
              "PAYMENT_SUMMARY",
              "ACTION_ROW"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "merchant_signature": {
      "type": "object",
      "required": ["did", "key_id", "algorithm", "signature"],
      "additionalProperties": false,
      "properties": {
        "did": {
          "type": "string",
          "pattern": "^did:(web|sonaraim):[a-zA-Z0-9._:-]+$"
        },
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string",
          "enum": ["Ed25519"]
        },
        "signature": {
          "type": "string"
        }
      }
    }
  }
}
